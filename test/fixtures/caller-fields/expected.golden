{-# LANGUAGE DisambiguateRecordFields #-}

module Main
  ( main
  ) where

-- Qualified-ONLY import: the field labels below are legal unqualified
-- solely because DisambiguateRecordFields resolves them via the
-- constructor. The bundler must rename them via the constructor too.
box :: BoxQ
box = MkBoxQ {contentQ = 41, labelQ = "x"}

grab :: BoxQ -> Int
grab MkBoxQ {contentQ = c} = c

main :: IO ()
main = do
  print (grab box)
  print (labelQ box)

-- ### Mod
data BoxQ = MkBoxQ
  { contentQ :: Int
  , labelQ :: String
  }

myFuncQ :: Int -> Int
myFuncQ = (* 2)

myOtherQ :: Int -> Int -> Int
myOtherQ = (+)
