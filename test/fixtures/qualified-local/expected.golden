module Main
  ( main
  ) where

main :: IO ()
main = do
  let h = pushA 1 emptyHeapA
  print (fA h)
  print (sizeA h)
  print (fB 41)

-- ### Beta
fB :: Int -> Int
fB = succ

-- ### Alpha
data HeapA = HeapA
  { itemsA :: [Int]
  , sizeA :: Int
  }

emptyHeapA :: HeapA
emptyHeapA = HeapA {itemsA = [], sizeA = 0}

pushA :: Int -> HeapA -> HeapA
pushA x h = HeapA {itemsA = x : itemsA h, sizeA = sizeA h + 1}

fA :: HeapA -> Int
fA h = sum (itemsA h) + sizeA h
