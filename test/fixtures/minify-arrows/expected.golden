{-# LANGUAGE Arrows #-}
module Main ( main ) where
import qualified Control.Arrow ; import Control.Arrow

main :: IO ()
main = print (pipelineA 20)

pipelineA :: Int -> Int ; pipelineA = runId $ proc x -> do { let { y = x + 1 } ; z <- arr (* 2) -< y ; case even z of { True -> returnA -< z ; False -> returnA -< z + 1 } } where { runId f = f } ; runKleisliLikeA :: (Int -> Int) -> Int -> Int ; runKleisliLikeA f = f
