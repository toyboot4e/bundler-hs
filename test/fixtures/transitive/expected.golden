{-# LANGUAGE Haskell2010 #-}
{-# LANGUAGE LambdaCase #-}

module Main (
        main
    ) where

-- ### Algo.C

sumUpAlgoC :: [Int] -> Int

sumUpAlgoC
  = sum
      . map
          (\case
             0 -> 1
             n -> n)

-- ### Algo.B

solveBB :: [Int] -> Int

solveBB xs = sumUpAlgoC xs * 2

-- ### Algo.A

solveAA :: [Int] -> Int

solveAA xs = sumUpAlgoC xs + 1

main :: IO ()

main
  = do print (solveAA [1, 2, 3])
       print (solveBB [1, 2, 3])
