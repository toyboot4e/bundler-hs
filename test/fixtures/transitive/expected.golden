{-# LANGUAGE Haskell2010 #-}
{-# LANGUAGE LambdaCase #-}

module Main
  ( main
  ) where

-- ### Algo.C
sumUp :: [Int] -> Int
sumUp =
  sum
    . map
        (\case
           0 -> 1
           n -> n)

-- ### Algo.A
solveAA :: [Int] -> Int
solveAA xs = sumUp xs + 1

-- ### Algo.B
solveBB :: [Int] -> Int
solveBB xs = sumUp xs * 2

main :: IO ()
main = do
  print (solveAA [1, 2, 3])
  print (solveBB [1, 2, 3])
