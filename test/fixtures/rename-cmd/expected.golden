module Main
  ( main
  ) where

import qualified Data.Map.Strict as DataMapStrict

-- ### (user code)
main :: IO ()
main = do
  print (f_A 1)
  print (g_B 2)
  print (count_C "abracadabra")

-- ### OpsB
(<.+>) :: Int -> Int -> Int
(<.+>) = (*)

g_B :: Int -> Int
g_B x = x <.+> 10

-- ### OpsA
infixl 6 <+.>
(<+.>) :: Int -> Int -> Int
(<+.>) = (+)

f_A :: Int -> Int
f_A x = x <+.> 10

-- ### Counter
data Tally_C = Tally_C
  { total_C :: Int
  , distinct_C :: Int
  } deriving (Show)

count_C :: String -> Tally_C
count_C s =
  let m = DataMapStrict.fromListWith (+) [(c, 1 :: Int) | c <- s]
   in Tally_C {total_C = length s, distinct_C = DataMapStrict.size m}
