module Main
  ( main
  ) where

main :: IO ()
main = do
  print ((1, 2) <+> (3, 4))
  print ((1, 2) <+> originV)
  print (scaleV 2 (3, 4))
  print (foldr (<+>) originV [(1, 1), (2, 2)])

-- ### Vec
infixl 6 <+>
type V2V = (Int, Int)

originV :: V2V
originV = (0, 0)

(<+>) :: V2V -> V2V -> V2V
(a, b) <+> (c, d) = (a + c, b + d)

scaleV :: Int -> V2V -> V2V
scaleV k v = (k, k) `mul` v
  where
    mul (a, b) (c, d) = (a * c, b * d)
