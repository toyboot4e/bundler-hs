{-# LANGUAGE LambdaCase #-}
{-# LANGUAGE TupleSections #-}
module Main ( main ) where
import Data.List (sortBy) ; import Data.Ord (comparing)

-- ### (user code)
-- User code stays hindent-formatted while the library and imports are
-- minified.
solve :: [Int] -> [Int]
solve =
  sortBy (comparing negate)
    . map
        (\case
           0 -> incAlg 0
           n -> n)

main :: IO ()
main = print (solve [3, 0, 2, 1])

-- ### Alg
incAlg :: Int -> Int
incAlg = (+ 1)
