{-# LANGUAGE CPP #-}

module Main
  ( main
  )
-- ### (user code)
 where
#ifdef LOCAL
debug :: Show a => a -> IO ()
debug = print
#else
debug :: Show a => a -> IO ()
debug _ = pure ()
#endif
main :: IO ()
main = do
  debug (incAlg 1)
  print (incAlg 41)

-- ### Alg
incAlg :: Int -> Int
incAlg = (+ 1)
