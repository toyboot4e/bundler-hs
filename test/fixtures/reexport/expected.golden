module Main
  ( main
  ) where

main :: IO ()
main = do
  print (shrink 1)
  -- reaches Main through Bulk -> Extra -> Core
  print (growC 2)
  -- in scope from both Core and Bulk: same origin, not ambiguous
  print (flattenC 3)
  -- qualified access through two levels of re-export
  print (growC 4)

-- ### Core
flattenC :: Int -> Int
flattenC = subtract 1

growC :: Int -> Int
growC x = x + 1

-- ### Extra
shrink :: Int -> Int
shrink x = flattenC (growC x) - 1
