module Main
  ( main
  ) where

main :: IO ()
main = do
  print (shrinkExtra 1)
  -- reaches Main through Bulk -> Extra -> Core
  print (growCore 2)
  -- in scope from both Core and Bulk: same origin, not ambiguous
  print (flattenCore 3)
  -- qualified access through two levels of re-export
  print (growCore 4)

-- ### Core
flattenCore :: Int -> Int
flattenCore = subtract 1

growCore :: Int -> Int
growCore x = x + 1

-- ### Extra
shrinkExtra :: Int -> Int
shrinkExtra x = flattenCore (growCore x) - 1
-- ### Bulk
