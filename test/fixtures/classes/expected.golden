module Main
  ( main
  ) where

-- ### (user code)
-- An instance of the local class, in the user's file: the method binder
-- must be renamed to match the renamed class method.
data Box =
  Box Int

instance PrettyP Box where
  prettyP (Box n) = "Box " <> prettyP n
  indentP _ = 2

-- An instance of an EXTERNAL class (Show): its method binder must stay
-- `show` even though the open import of Decoy puts a same-named local
-- export in unqualified scope.
newtype Tag =
  Tag Int

instance Show Tag where
  show (Tag n) = "#" <> displayDecoy n

main :: IO ()
main = do
  putStrLn (prettyP (Box 1))
  print (indentP (Box 1))
  print (Tag 7)

-- ### Pretty
class PrettyP a where
  prettyP :: a -> String
  indentP :: a -> Int
  indentP _ = 0

instance PrettyP Int where
  prettyP = show

-- ### Decoy
displayDecoy :: Int -> String
displayDecoy n = "<" <> Prelude.show n <> ">"

showDecoy :: Int -> String
showDecoy = displayDecoy
