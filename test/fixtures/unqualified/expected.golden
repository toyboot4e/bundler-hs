module Main
  ( main
  ) where

-- ### (user code)
main :: IO ()
main = do
  print (incUtil 41)
  print (clampUtil 0 10 99)
  print (twiceExtra 21)
  let p = MkPairUtil {leftUtil = 1, rightUtil = 2}
  print (leftUtil p + rightUtil p)

-- ### Util
data PairUtil = MkPairUtil
  { leftUtil :: Int
  , rightUtil :: Int
  }

incUtil :: Int -> Int
incUtil = (+ 1)

clampUtil :: Int -> Int -> Int -> Int
clampUtil lo hi = max lo . min hi

privateUtil :: Int
privateUtil = 0

-- ### Extra
twiceExtra :: Int -> Int
twiceExtra x = x * 2

unusedExtra :: Int
unusedExtra = 99
