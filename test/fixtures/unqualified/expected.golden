module Main
  ( main
  ) where

main :: IO ()
main = do
  print (inc 41)
  print (clamp 0 10 99)
  print (twice 21)
  let p = MkPair {left = 1, right = 2}
  print (left p + right p)

-- ### Util
data Pair = MkPair
  { left :: Int
  , right :: Int
  }

inc :: Int -> Int
inc = (+ 1)

clamp :: Int -> Int -> Int -> Int
clamp lo hi = max lo . min hi

private :: Int
private = 0

-- ### Extra
twice :: Int -> Int
twice x = x * 2

unused :: Int
unused = 99
