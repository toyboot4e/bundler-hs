module Main
  ( main
  ) where

import qualified Data.Char
import Data.Char
import qualified Data.List
import qualified Data.Map.Strict as MyMap
import qualified Data.Map.Strict
import qualified Data.Ord

main :: IO ()
main = do
  print (countUpCA [1, 2, 2, 3])
  print (rankedCB [3, 1, 2])
  print (MyMap.singleton (1 :: Int) "user alias survives")

-- ### CountB
rankedCB :: [Int] -> [(Int, String)]
rankedCB xs =
  [ (k, map toUpper v)
  | (k, v) <-
      Data.Map.Strict.toList
        (Data.Map.Strict.fromList
           (zip (Data.List.sortBy (Data.Ord.comparing negate) xs) ["a", "b", "c"]))
  ]

-- ### CountA
countUpCA :: [Int] -> [(Int, Int)]
countUpCA xs = Data.Map.Strict.toList (Data.Map.Strict.fromListWith (+) [(x, 1) | x <- xs])
