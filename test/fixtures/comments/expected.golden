-- top-of-file comment (part of the header block, kept above the pragmas)
module Main ( main ) where
import Data.List ( sort )

-- a comment between imports
-- | Doc comment on the solver.
solve :: [Int] -> Int
solve xs = f (foldr push emptyHeap (sort xs)) -- trailing comment

{- a block comment
   between declarations -}
main :: IO ()
main = print (solve [3, 1, 2])

-- closing remark

data Heap = Heap {items :: [Int], size :: Int} ; emptyHeap :: Heap ; emptyHeap = Heap {items = [], size = 0} ; push :: Int -> Heap -> Heap ; push x h = Heap {items = x : items h, size = size h + 1} ; f :: Heap -> Int ; f h = sum (items h) + size h
