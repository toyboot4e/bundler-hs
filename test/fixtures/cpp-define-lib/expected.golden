{-# LANGUAGE CPP #-}

module Main
  ( main
  ) where

main :: IO ()
main = print (limitM, twiceM 4, totalM, flaggedM, stateM, labelM)

-- ### Macro
limitM :: Int
limitM = 1000000007

twiceM :: Int -> Int
twiceM n = ((n) + (n))

totalM :: Int
totalM = ((1) + (2) + (3))

flaggedM :: Bool
flaggedM = True

stateM :: Int
stateM = 0

labelM :: (String, Char)
labelM = ("LIMIT stays", 'X')
