{-# LANGUAGE BangPatterns, PatternSynonyms, TypeApplications #-}
module Main ( main ) where

main :: IO ()
main = do
  print (readInt "41")
  print (sumStrict [1, 2, 3])
  print (True --> False)
  print (classify (-1))
  print (lazySnd (1, 2))
  case [5 :: Int] of
    Single x -> print (x, Single x)
    _ -> pure ()

pattern Single :: a -> [a] ; pattern Single x <- [x] where { Single x = [x] } ; data Acc = Acc { getAcc :: !Int } ; (-->) :: Bool -> Bool -> Bool ; True --> b = b ; False --> _ = True ; infixr 1 --> ; readInt :: String -> Int ; readInt = read @Int ; sumStrict :: [Int] -> Int ; sumStrict = go (Acc 0) where { go (Acc !acc) [] = acc ; go (Acc !acc) (x:xs) = go (Acc (acc + x)) xs } ; classify :: Int -> String ; classify (1) = "neg one" ; classify 0 = "zero" ; classify _ = "other" ; lazySnd :: (Int, Int) -> Int ; lazySnd ~(_, b) = b
