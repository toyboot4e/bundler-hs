{-# LANGUAGE RecordWildCards #-}
{-# LANGUAGE NamedFieldPuns #-}

module Main
  ( main
  ) where

shift :: Point -> Point
shift p = p {px = px p + 1}

viaPuns :: Point -> Int
viaPuns Point {px = px} = px

viaWildcards :: Point -> Int
viaWildcards Point {py = py, px = px} = px + py

build :: Int -> Point
build n =
  let px = n
      py = n * 2
   in Point {py = py, px = px}

main :: IO ()
main = do
  let p = Point {px = 3, py = 4}
  print (norm p)
  print (norm (shift p))
  print (viaPuns p)
  print (viaWildcards p)
  print (norm (build 5))

-- ### Rec
data Point = Point
  { px :: Int
  , py :: Int
  }

norm :: Point -> Int
norm Point {py = py, px = px} = px * px + py * py
