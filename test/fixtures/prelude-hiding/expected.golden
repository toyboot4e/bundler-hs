module Main
  ( main
  ) where

import Prelude

main :: IO ()
main = do
  -- Prelude's read must survive the bundling.
  print (read "42" :: Int)
  print (readPair "abc")

-- ### Reader
readR :: String -> Int
readR s = length s

readPair :: String -> (Int, Int)
readPair s = (readR s, readR (reverse s))
