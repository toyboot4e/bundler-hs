module Main
  ( main
  ) where

import qualified Data.List
import Data.List

main :: IO ()
main = print (insertS 1 [2], size [1, 2], merge [3, 1])

-- ### Store
insertS :: Int -> [Int] -> [Int]
insertS = (:)

size :: [Int] -> Int
size = length

-- ### Sorted
merge :: [Int] -> [Int]
merge xs = insert 0 (sort xs)
