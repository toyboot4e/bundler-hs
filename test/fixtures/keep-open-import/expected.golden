module Main
  ( main
  ) where

import qualified Data.List
import Data.List hiding (main, merge, partition, size)

main :: IO ()
main = print (insertS 1 [2], size [1, 2], partition [4], merge [3, 1])

-- ### Store
insertS :: Int -> [Int] -> [Int]
insertS = (:)

size :: [Int] -> Int
size = length

partition :: [Int] -> ([Int], [Int])
partition xs = (xs, [])

-- ### Sorted
merge :: [Int] -> [Int]
merge xs = insert 0 (sort xs)
